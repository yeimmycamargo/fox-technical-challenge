{
  "name": "demoblaze-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Demoblaze UI tests: WebdriverIO, Mocha, POM, JSON, Allure",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "npm run clean && wdio run wdio.conf.js",
    "test:signup": "npm test -- --suite signup",
    "test:login": "npm test -- --suite login",
    "test:cart": "npm test -- --suite cart",
    "test:checkout": "npm test -- --suite checkout",
    "test:headless": "cross-env HEADLESS=true npm test",
    "lint": "eslint .",
    "clean": "node scripts/clean.js",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@wdio/allure-reporter": "10.0.1",
    "@wdio/cli": "10.0.2",
    "@wdio/globals": "10.0.2",
    "@wdio/local-runner": "10.0.2",
    "@wdio/mocha-framework": "10.0.1",
    "@wdio/spec-reporter": "10.0.1",
    "allure-commandline": "2.46.1",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "webdriverio": "10.0.2"
  }
}
